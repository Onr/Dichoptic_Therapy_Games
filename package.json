{
  "name": "dichoptic_therapy_games",
  "version": "1.2.0",
  "description": "Production-ready browser-based therapeutic memory card game designed for dichoptic treatment of diplopia or amblyopia using red-green anaglyph glasses. Features comprehensive logging, monitoring, error handling, and production-grade reliability.",
  "main": "game.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ game.js --ext .js",
    "lint:fix": "eslint src/ game.js --ext .js --fix",
    "build": "npm run lint && npm test",
    "start": "npm run setup && npm run serve",
    "serve": "http-server -p 8080 -c-1",
    "setup": "node -e \"console.log('Running production setup...')\" && npm run build",
    "analyze": "npm run test:coverage && npm run lint",
    "security-audit": "npm audit --audit-level moderate",
    "production-check": "npm run build && npm run security-audit",
    "deploy-prep": "npm run production-check && npm run analyze"
  },
  "keywords": [
    "dichoptic therapy",
    "amblyopia treatment",
    "diplopia rehabilitation",
    "vision therapy",
    "medical game",
    "accessibility",
    "therapeutic gaming",
    "binocular vision",
    "memory game",
    "production-ready"
  ],
  "author": "Tal Bar Nizan & Ori Nizan",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "eslint": "^8.50.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/**/*.js",
      "game.js",
      "!src/**/node_modules/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "node": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error",
      "no-undef": "error",
      "prefer-const": "error",
      "no-var": "error"
    },
    "globals": {
      "gtag": "readonly",
      "ga": "readonly"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Onr/Dichoptic_Therapy_Games.git"
  },
  "bugs": {
    "url": "https://github.com/Onr/Dichoptic_Therapy_Games/issues"
  },
  "homepage": "https://github.com/Onr/Dichoptic_Therapy_Games#readme"
}
