# Server Configuration
PORT=8086

# Environment
NODE_ENV=production

# Analytics
ENABLE_ANALYTICS=false
GA_TRACKING_ID=

# Production Features
ENABLE_LOGGING=true
ENABLE_MONITORING=true
ENABLE_ERROR_REPORTING=true
ENABLE_HEALTH_CHECKS=true
ENABLE_SERVICE_WORKER=true

# Performance
ENABLE_COMPRESSION=true
ENABLE_CACHING=true

# Security
ENABLE_SECURITY_HEADERS=true
